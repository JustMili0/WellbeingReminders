{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "sources": "https://github.com/JustMili0/WellbeingReminders",
    "issues": "https://github.com/JustMili0/WellbeingReminders/issues",
    "homepage": "https://modrinth.com/mod/wellbeing-reminders"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.justmili.reminders.client.RemindersClient"
    ],
    "sodium:config_api_user": [
      "net.justmili.reminders.client.config.SodiumApiOptions"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_constraint}",
    "sodium": "*"
  },
  "recommends": {
    "reeses-sodium-options": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/wellbeing-reminders",
        "modmenu.discord": "https://discord.gg/DPEw9DU2vT",
        "modmenu.kofi": "https://ko-fi.com/justmilivt",
        "modmenu.twitter": "https://x.com/JustMiliVT"
      }
    }
  }
}